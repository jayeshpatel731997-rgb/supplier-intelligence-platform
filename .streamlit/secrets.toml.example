# Streamlit local/staging secrets template.
# Copy to .streamlit/secrets.toml for local private use only.
# Do not commit real secrets.

SUPPLIER_SECURITY_MODE = "local"
SUPPLIER_DEPLOYMENT_MODE = "demo"
SUPPLIER_DEMO_MODE = true
SUPPLIER_API_BASE_URL = "http://localhost:8000"

# Local pilot login for Streamlit. Use a strong password outside local demos.
SUPPLIER_APP_ADMIN_USER = "admin"
SUPPLIER_APP_ADMIN_PASSWORD = "replace-with-local-secret"
SUPPLIER_APP_SESSION_TIMEOUT_MINUTES = 60

# FastAPI OIDC validates bearer tokens. Streamlit browser OIDC callback is
# scaffold/documented separately and should not be treated as complete SSO until
# a real IdP redirect/callback flow and tenant membership sync are validated.
AUTH_PROVIDER = "local"
OIDC_ISSUER_URL = ""
OIDC_CLIENT_ID = ""
OIDC_CLIENT_SECRET = ""
OIDC_AUDIENCE = ""
OIDC_JWKS_URL = ""
OIDC_ALGORITHMS = "RS256"
OIDC_CLOCK_SKEW_SECONDS = 60
OIDC_REDIRECT_URI = ""

# Upload scanning: "eicar-test" is a staging-safe proof adapter only.
SUPPLIER_UPLOAD_SCANNER_REQUIRED = false
SUPPLIER_UPLOAD_SCANNER_PROVIDER = "none"
SUPPLIER_UPLOAD_SCANNER_ENDPOINT_URL = ""

# Optional external intelligence providers.
NEWSAPI_KEY = ""
OPENAI_API_KEY = ""
ANTHROPIC_API_KEY = ""
